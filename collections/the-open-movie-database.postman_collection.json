  "info": {
    "_postman_id": "bf09a29b-357b-4553-92bb-31dceb84ff69",
    "name": "The Open Movie Database API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The OMDb API is a RESTful web service to obtain movie, series, and episode information. All content and images on the site are contributed and maintained by users. Access movie and TV metadata including title, year, genre, director, cast, plot, ratings, and IMDb data. Search by title or look up by IMDb ID. Requires a free API key obtained at omdbapi.com/apikey.aspx.",
      "type": "text/plain"
    }
  }
