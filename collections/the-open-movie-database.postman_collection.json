          "name": "Search Movies By Title",
          "request": {
            "name": "Search Movies By Title",
            "description": {
              "content": "Search for movies, series, or episodes by title. Returns a paginated list of matching results. Note: The search endpoint uses the same base URL (https://www.omdbapi.com/) with the 's' parameter instead of 't'.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your OMDb API key."
                },
                {
                  "disabled": false,
                  "key": "s",
                  "value": "<string>",
                  "description": "(Required) Search term — movie title or partial title to search for."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by type: movie, series, or episode."
                },
                {
                  "disabled": false,
                  "key": "y",
                  "value": "<integer>",
                  "description": "Year of release filter."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (1-100, default 1). Each page contains up to 10 results."
                },
                {
                  "disabled": false,
                  "key": "r",
                  "value": "json",
                  "description": "Response format: json (default) or xml."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name."
                }
