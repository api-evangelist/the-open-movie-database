          "name": "Get Movie By Title Or IMDb ID",
          "request": {
            "name": "Get Movie By Title Or IMDb ID",
            "description": {
              "content": "Retrieve detailed information about a single movie, TV series, or episode by IMDb ID or title. At least one of the 'i' (IMDb ID) or 't' (title) parameters is required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your OMDb API key."
                },
                {
                  "disabled": false,
                  "key": "i",
                  "value": "<string>",
                  "description": "A valid IMDb ID (e.g., tt1285016). Required if 't' is not provided."
                },
                {
                  "disabled": false,
                  "key": "t",
                  "value": "<string>",
                  "description": "Movie or series title to retrieve. Required if 'i' is not provided."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Type of result to return: movie, series, or episode."
                },
                {
                  "disabled": false,
                  "key": "y",
                  "value": "<integer>",
                  "description": "Year of release."
                },
                {
                  "disabled": false,
                  "key": "plot",
                  "value": "short",
                  "description": "Return short or full plot. Values: short (default), full."
                },
                {
                  "disabled": false,
                  "key": "r",
                  "value": "json",
                  "description": "Response format. Values: json (default), xml."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name."
                },
                {
                  "disabled": false,
                  "key": "v",
                  "value": "1",
                  "description": "API version (default 1)."
                },
                {
                  "disabled": false,
                  "key": "Season",
                  "value": "<integer>",
                  "description": "Season number (integer). Used to retrieve a specific TV season."
                },
                {
                  "disabled": false,
                  "key": "Episode",
                  "value": "<integer>",
                  "description": "Episode number (integer). Used with Season to retrieve a specific episode."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
